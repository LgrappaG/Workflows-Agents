# Dynamic Hooks Configuration
# Copy to .env or .env.local to activate

# ============================================================================
# CONTEXT & PHASE CONFIGURATION
# ============================================================================

# Active validation phase
# Options: phase_4 (strict), phase_5_enrichment (lenient), phase_6_bootstrap (experimental)
HOOKS_CONTEXT=phase_4

# Validation mode (overrides phase default)
# Options: strict (100%), lenient (120% tolerance), experimental (150% tolerance)
# HOOKS_MODE=strict

# ============================================================================
# ENVIRONMENT DETECTION
# ============================================================================

# Environment type (auto-detected, but can override)
# Options: ci_strict, local_development, pre_commit
# HOOKS_ENV=local_development

# ============================================================================
# DEBUGGING & VERBOSE OUTPUT
# ============================================================================

# Enable debug output
DEBUG=0

# Show detailed validation messages
VERBOSE=0

# ============================================================================
# GIT HOOKS CONFIGURATION
# ============================================================================

# Auto-run hooks on git operations
# GIT_HOOKS_ENABLED=1

# Skip hooks for specific operations
# GIT_HOOKS_SKIP_COMMIT_MSG=0
# GIT_HOOKS_SKIP_PRE_COMMIT=0

# ============================================================================
# CUSTOMIZE PHASE-SPECIFIC RULES
# ============================================================================

# Phase 4 (Production Strict)
# PHASE_4_DESCRIPTION_MIN=50
# PHASE_4_DESCRIPTION_MAX=100
# PHASE_4_FILE_SIZE_MAX=1200

# Phase 5 (Enriched Content)
# PHASE_5_DESCRIPTION_MAX=150
# PHASE_5_FILE_SIZE_MAX=1500

# Phase 6 (Bootstrap)
# PHASE_6_DESCRIPTION_MIN=30
# PHASE_6_MANDATES_MIN=2

# ============================================================================
# COMMON WORKFLOWS
# ============================================================================

# Workflow: Local Development (relaxed rules)
# Uncomment all lines below:
# HOOKS_CONTEXT=phase_5_enrichment
# HOOKS_MODE=lenient
# DEBUG=1

# Workflow: CI/CD (strict rules)
# Uncomment all lines below:
# HOOKS_CONTEXT=phase_4
# HOOKS_MODE=strict
# DEBUG=0

# Workflow: Feature Development (experimental)
# Uncomment all lines below:
# HOOKS_CONTEXT=phase_6_bootstrap
# HOOKS_MODE=experimental
# DEBUG=1
